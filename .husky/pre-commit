#!/bin/sh
# BufoIndex Pre-commit Quality Gates
# Prevents Sprint 08 critical issues from reaching the repository

# Ensure we're in the project root
cd "$(dirname "$0")/.."

echo "🚨 BufoIndex Pre-commit Quality Gates"
echo "====================================="

# Run quality gates
if ./scripts/quality-gates.sh all; then
    echo "✅ All quality gates passed - commit allowed"
    exit 0
else
    echo ""
    echo "❌ Quality gate failures detected"
    echo ""
    echo "🔧 Quick fixes:"
    echo "  • TypeScript errors: npm run type-check"
    echo "  • Test failures: npm test"
    echo "  • Linting issues: npm run lint"
    echo ""
    echo "🆘 Emergency bypass (use sparingly):"
    echo "  • HUSKY_SKIP_HOOKS=1 git commit -m \"emergency: reason\""
    echo ""
    echo "📚 More info: docs/architecture/quality-gates.md"
    echo ""
    exit 1
fi
