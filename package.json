{
  "name": "bufoindex",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive personal-finance calculators: paycheck allocation, Monte Carlo retirement modeling, multi-account portfolio rebalancing, and a leveraged versus plain index fund comparison. Client-side only.",
  "homepage": "https://bufoindex.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bufothefrog/bufoindex.git"
  },
  "bugs": {
    "url": "https://github.com/bufothefrog/bufoindex/issues"
  },
  "author": "bufothefrog",
  "license": "AGPL-3.0-only",
  "keywords": [
    "personal-finance",
    "retirement-calculator",
    "monte-carlo",
    "portfolio-rebalancing",
    "paycheck-allocator",
    "nextjs",
    "typescript"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'npm run type-check'"
    ],
    "*.{js,jsx,mjs}": "eslint --fix"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.6.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "katex": "^0.18.10",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "26.x"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
